      <xs:element name="Target_begin" type="Node" maxOccurs="1" minOccurs="1"/>
      <xs:element name="Value" type="FlowType" maxOccurs="1" minOccurs="1"/>
    </xs:sequence>
    <xs:attribute type="xs:string" name="phase" use="required"/>
  </xs:complexType> -->

  <xs:complexType name="Feeds">
    <xs:sequence>
      <xs:element name="Flux" type="FeedFlux" maxOccurs="unbounded" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>


